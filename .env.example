# ===========================================================================
# Classroom Portal — environment variables
#
# Copy this file to ".env" for local development, or paste these into your
# Vercel project's Environment Variables screen for the live site.
#
# EVERY variable is optional. With none set, the site builds and runs using
# friendly defaults (sample wish list + the custom theme). Fill in what you
# want to change. See docs/teacher-guide.md for a plain-language walkthrough.
# ===========================================================================

# ── Site identity ──────────────────────────────────────────────────────────
# Shown in the header, browser tab, and search-engine previews.
SITE_TITLE="Our Classroom Portal"
SITE_TAGLINE="A little help goes a long way"
SITE_DESCRIPTION="Our classroom supply wish list. Donations through these links help stock our room at no extra cost to you."
# Your live site address (used for SEO and social-share previews). Set this to
# your Vercel URL or custom domain once you have one.
SITE_URL="https://example.com"

# ── Donations page ─────────────────────────────────────────────────────────
DONATIONS_TITLE="Our Classroom Wish List"
DONATIONS_INTRO="These are the supplies our class is hoping for this year. Each link goes straight to the item on Amazon."

# ── Contact ────────────────────────────────────────────────────────────────
CONTACT_EMAIL="teacher@example.com"

# Optional footer social links, as a JSON array. Leave unset to hide them.
# SOCIAL_LINKS_JSON=[{"label":"Instagram","href":"https://instagram.com/you"}]

# ── Theme ──────────────────────────────────────────────────────────────────
# 0 = Custom (your own — the default)   1 = Garden    2 = Press
# 3 = Dusk (dark)                       4 = Sunrise
# Changing this requires a redeploy. See docs/customizing-css.md.
THEME_INDEX=0

# ── Where your wish list lives ─────────────────────────────────────────────
# "static-json"  = edit src/app/data/donations.json in GitHub (the default)
# "google-sheets"= read a Google Sheet published to the web as CSV
STORAGE_PROVIDER="static-json"
# Required only when STORAGE_PROVIDER="google-sheets". Paste the CSV link from
# Google Sheets: File -> Share -> Publish to web -> (your sheet) -> CSV.
GOOGLE_SHEET_CSV_URL=""

# ── Amazon Associates ──────────────────────────────────────────────────────
# Your Associates tracking tag, e.g. "myclassroom-20". Used in your links.
AMAZON_ASSOCIATE_TAG=""

# ── Amazon Product Advertising API (PAAPI) — OPTIONAL, advanced ─────────────
# Leave these BLANK until Amazon grants you PAAPI access (you need ~3 sales
# first). When all three are set, the donations page automatically fills in
# product images and live prices. Until then the site works fine without them.
# These are SECRETS — never commit real values; set them only in Vercel.
PAAPI_ACCESS_KEY=""
PAAPI_SECRET_KEY=""
PAAPI_PARTNER_TAG=""
# Defaults below suit Amazon US. Change only for non-US marketplaces.
# PAAPI_HOST="webservices.amazon.com"
# PAAPI_REGION="us-east-1"
