{
  "name": "classroom-portal",
  "version": "1.0.0",
  "description": "A fill-in-the-blanks template for a two-page Amazon-affiliate donations portal (landing page + donations page), built on Angular 21 SSR and deployable free on Vercel.",
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "setup": "node scripts/setup.mjs",
    "start": "node --env-file-if-exists=.env scripts/generate-config.mjs && ng serve",
    "build": "node --env-file-if-exists=.env scripts/generate-config.mjs && ng build",
    "watch": "node --env-file-if-exists=.env scripts/generate-config.mjs && ng build --watch --configuration development",
    "test": "ng test",
    "test:coverage": "ng test --coverage",
    "serve:ssr": "node dist/classroom-portal/server/server.mjs"
  },
  "private": true,
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "overrides": {
    "crypto-js": "^4.2.0"
  },
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/platform-server": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@angular/ssr": "^21.2.6",
    "@ngrx/signals": "^21.1.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "bootstrap": "^5.3.8",
    "express": "^5.1.0",
    "paapi5-nodejs-sdk": "^1.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.6",
    "@angular/cli": "^21.2.6",
    "@angular/compiler-cli": "^21.2.0",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "@vitest/coverage-v8": "^4.1.7",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
